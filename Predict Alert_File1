-- =====================================================================
-- FILE 1 OF 3 — INGEST CURRENT-WEEK DATA, APPEND TO HISTORY
-- Run this every time a new week's raw file has been imported.
-- Set @retailer, update the FROM table name in that retailer's
-- adapter block if needed, then run the whole script.
--
-- OUTPUTS:
--   Haleon.F1_S1_CurrentWeek_Normalized  — SCRATCH. Dropped and rebuilt every
--                                    run. Holds only this run's newly
--                                    loaded week(s), in canonical shape.
--   Haleon.Retailer_Sales_History  — PERSISTENT. Grows over time. Safe
--                                    to re-run: existing retailer+week
--                                    combos are replaced, not duplicated.
-- =====================================================================

DECLARE @retailer VARCHAR(50);
SET @retailer = 'Asda';


-- =====================================================================
-- STEP 1: CREATE COMMON CURRENT-WEEK STRUCTURE
-- =====================================================================
IF OBJECT_ID('Haleon.F1_S1_CurrentWeek_Normalized', 'U') IS NOT NULL
    DROP TABLE Haleon.F1_S1_CurrentWeek_Normalized;

CREATE TABLE Haleon.F1_S1_CurrentWeek_Normalized
(
    store_id          VARCHAR(50)    NOT NULL,
    sku_id            VARCHAR(50)    NOT NULL,
    sku_description   NVARCHAR(200)  NULL,
    year_week         INT            NOT NULL,
    week_commencing   DATE           NULL,
    sales_qty         NUMERIC(18,2)  NULL,
    sales_value       NUMERIC(18,2)  NULL,
    stock_qty         NUMERIC(18,2)  NULL
);


-- =====================================================================
-- STEP 1A: ASDA RETAILER ADAPTER
-- Weekly change: update only the FROM table name when required.
-- =====================================================================
IF @retailer = 'Asda'
BEGIN
    INSERT INTO Haleon.F1_S1_CurrentWeek_Normalized
    (
        store_id, sku_id, sku_description, year_week,
        week_commencing, sales_qty, sales_value, stock_qty
    )
    SELECT
        CAST([Site_Number] AS VARCHAR(50)),
        CAST([Article_ID] AS VARCHAR(50)),
        CAST([Article_Description] AS NVARCHAR(200)),

        YEAR(CONVERT(DATE, [Asda_Daily])) * 100
            + DATEPART(ISO_WEEK, CONVERT(DATE, [Asda_Daily])),

        CAST(
            DATEADD(
                DAY,
                -(DATEDIFF(DAY, 0, CONVERT(DATE, [Asda_Daily])) % 7),
                CONVERT(DATE, [Asda_Daily])
            )
        AS DATE),

        CAST([Sales_Qty] AS NUMERIC(18,2)),
        CAST([Sales_Amount] AS NUMERIC(18,2)),
        CAST(NULL AS NUMERIC(18,2))

    FROM Haleon.Haleon_Asda_CurrentWeek_2026_W35;  -- <<< UPDATE EACH WEEK
END;


-- =====================================================================
-- STEP 1B: TESCO RETAILER ADAPTER
-- =====================================================================
IF @retailer = 'Tesco'
BEGIN
    INSERT INTO Haleon.F1_S1_CurrentWeek_Normalized
    (
        store_id, sku_id, sku_description, year_week,
        week_commencing, sales_qty, sales_value, stock_qty
    )
    SELECT
        CAST([Store ID] AS VARCHAR(50)),
        CAST([TPNB] AS VARCHAR(50)),
        CAST([TPNB Description] AS NVARCHAR(200)),

        CAST([Year Week Number] AS INT),

        CAST(
            DATEADD(
                DAY,
                ((CAST([Year Week Number] AS INT) % 100) - 1) * 7
                    - (DATEDIFF(
                        DAY, 0,
                        DATEADD(YEAR, (CAST([Year Week Number] AS INT) / 100) - 1900, CONVERT(DATETIME, 3))
                      ) % 7),
                DATEADD(YEAR, (CAST([Year Week Number] AS INT) / 100) - 1900, CONVERT(DATETIME, 3))
            )
        AS DATE),

        CAST([Sales Volume TY] AS NUMERIC(18,2)),
        CAST([Sales Value TY] AS NUMERIC(18,2)),
        CAST([Stock Volume TY] AS NUMERIC(18,2))

    FROM Haleon.Haleon_Tesco_CurrentWeek;  -- <<< UPDATE EACH WEEK
END;


-- =====================================================================
-- STEP 1C: BOOTS RETAILER ADAPTER
-- Not enabled until Boots source columns are known.
-- =====================================================================
IF @retailer = 'Boots'
BEGIN
    RAISERROR('Boots adapter is not configured yet. Provide a Boots sample/source column list first.', 16, 1);
    RETURN;
END;


-- =====================================================================
-- INVALID RETAILER CHECK
-- =====================================================================
IF @retailer NOT IN ('Asda', 'Tesco', 'Boots')
BEGIN
    RAISERROR('Retailer not recognised. Valid configured retailers are Asda and Tesco.', 16, 1);
    RETURN;
END;


-- =====================================================================
-- STEP 1 VALIDATION
-- =====================================================================
SELECT
    @retailer AS retailer,
    year_week,
    MIN(week_commencing)     AS week_commencing,
    COUNT(*)                 AS raw_rows,
    COUNT(DISTINCT store_id) AS stores,
    COUNT(DISTINCT sku_id)   AS skus,
    SUM(sales_qty)           AS sales_qty,
    CAST(ROUND(SUM(sales_value), 2) AS NUMERIC(18,2)) AS sales_value
FROM Haleon.F1_S1_CurrentWeek_Normalized
GROUP BY year_week
ORDER BY year_week;


-- =====================================================================
-- STEP 2: CREATE SHARED RETAILER HISTORY IF NEEDED
-- This is the PERMANENT, ever-growing table. Every other file in this
-- pipeline (File 2, File 3) reads from this table's name — do not
-- rename it without updating both.
-- =====================================================================
IF OBJECT_ID('Haleon.Retailer_Sales_History', 'U') IS NULL
BEGIN
    CREATE TABLE Haleon.Retailer_Sales_History
    (
        retailer          VARCHAR(50)    NOT NULL,
        store_id          VARCHAR(50)    NOT NULL,
        sku_id            VARCHAR(50)    NOT NULL,
        sku_description   NVARCHAR(200)  NULL,
        year_week         INT            NOT NULL,
        week_commencing   DATE           NULL,
        sales_qty         NUMERIC(18,2)  NULL,
        sales_value       NUMERIC(18,2)  NULL,
        stock_qty         NUMERIC(18,2)  NULL
    );
END;


-- =====================================================================
-- STEP 3: REPLACE CURRENT RETAILER/WEEK IN HISTORY
-- Safe to re-run: existing rows for this retailer+week are deleted
-- before the fresh rows are inserted, so re-running never duplicates.
-- =====================================================================
DELETE hist
FROM Haleon.Retailer_Sales_History AS hist
INNER JOIN
(
    SELECT DISTINCT year_week
    FROM Haleon.F1_S1_CurrentWeek_Normalized
    WHERE year_week IS NOT NULL
) AS wk
    ON hist.year_week = wk.year_week
WHERE hist.retailer = @retailer;

INSERT INTO Haleon.Retailer_Sales_History
(
    retailer, store_id, sku_id, sku_description,
    year_week, week_commencing, sales_qty, sales_value, stock_qty
)
SELECT
    @retailer,
    store_id,
    sku_id,
    MIN(sku_description),
    year_week,
    MIN(week_commencing),
    SUM(sales_qty),
    SUM(sales_value),
    SUM(stock_qty)
FROM Haleon.F1_S1_CurrentWeek_Normalized
WHERE year_week IS NOT NULL
GROUP BY store_id, sku_id, year_week;


-- =====================================================================
-- STEP 4: FINAL VALIDATION
-- =====================================================================
SELECT
    retailer,
    year_week,
    MIN(week_commencing)     AS week_commencing,
    COUNT(*)                 AS store_sku_rows,
    COUNT(DISTINCT store_id) AS stores,
    COUNT(DISTINCT sku_id)   AS skus,
    SUM(sales_qty)           AS sales_qty,
    CAST(ROUND(SUM(sales_value), 2) AS NUMERIC(18,2)) AS sales_value
FROM Haleon.Retailer_Sales_History
WHERE retailer = @retailer
GROUP BY retailer, year_week
ORDER BY year_week;


-- =====================================================================
-- DUPLICATE CHECK — Expected result: 0 rows
-- =====================================================================
SELECT
    retailer, store_id, sku_id, year_week, COUNT(*) AS duplicate_rows
FROM Haleon.Retailer_Sales_History
WHERE retailer = @retailer
GROUP BY retailer, store_id, sku_id, year_week
HAVING COUNT(*) > 1
ORDER BY duplicate_rows DESC;


