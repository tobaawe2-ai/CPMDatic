--Boots Predict Alert — Interim T-SQL script
--Adapted from: Asda interim build (daily grain -> weekly aggregation,
--              store peer-grouping via NTILE) +
--              Tesco build (stock-aware alert classification:
--              Low Sales / Stock No Sales / Ranged Not Stocked)
--
--Boots-specific handling added in this script:
--  1. Product column arrives as "<Article_ID> - <Description>" combined
--     -> split on the FIRST " - " occurrence
--  2. Total_Sales_Amount_per_Store / Total_Sales_Volume_per_Store_Units
--     arrive as VARCHAR with literal string 'NA' mixed in with numerics
--     -> 'NA' is converted to NULL (not 0) — CHANGE IF YOU WANT 0 INSTEAD
--  3. Store_On_Hand_Volume_Units = Boots' stock field, equivalent to
--     Tesco's Stock Volume TY (NOT the same concept as ASDA's history,
--     which had no stock data at all)
--  4. Data is DAILY grain (like Asda), so needs Week_Commencing /
--     Year_Week_Number derivation and daily->weekly aggregation
--     (Tesco's raw data arrived pre-aggregated to weekly, so its
--     Step 6b only filtered — Boots needs to aggregate, like Asda did)
--
--ASSUMPTIONS TO CONFIRM / ADJUST:
--  - Raw landing table name: Haleon.Boots_Sales_Raw
--    (columns: Calendar, Store_Id, Product, Total_Sales_Amount_per_Store,
--     Total_Sales_Volume_per_Store_Units, Store_On_Hand_Volume_Units)
--  - Stock is AVERAGED across the week per store x article (a snapshot
--    value, not additive) — change to MAX/last-day if you'd rather
--  - @num_groups = 10 (matches Asda; Tesco used 20 — depends on Boots'
--    actual store count)
--  - ranged_flag hardcoded to 1 everywhere, same placeholder Tesco used
--    (no range/planogram source available for either retailer yet)
--  - GREATEST() and ANY_VALUE() need SQL Server 2022 compat level 160.
--    Fallback equivalents are commented next to each in case your
--    instance is still on a lower compat level (per earlier ASDA work).

-- =====================================================================
-- STEP 0: Normalize the historical raw landing table
--         (split Product, clean 'NA', derive week fields)
-- =====================================================================
DECLARE @load_start_date DATE = '2026-06-01';   -- <-- ADJUST: history window start

DROP TABLE IF EXISTS Haleon.Boots_Sales_History_Normalized;

SELECT
    [Store_Id]                                                       AS store_id,
    LTRIM(RTRIM(LEFT([Product], CHARINDEX(' - ', [Product]) - 1)))   AS article_id,
    LTRIM(RTRIM(SUBSTRING([Product], CHARINDEX(' - ', [Product]) + 3, 4000)))
                                                                      AS article_description,
    TRY_CAST(NULLIF([Total_Sales_Amount_per_Store], 'NA') AS NUMERIC(18,2))
                                                                      AS sales_value,
    TRY_CAST(NULLIF([Total_Sales_Volume_per_Store_Units], 'NA') AS INT)
                                                                      AS sales_qty,
    TRY_CAST(NULLIF([Store_On_Hand_Volume_Units], 'NA') AS INT)      AS stock_volume,
    CAST([Calendar] AS DATE)                                         AS sale_date,
    CAST(
        DATEADD(
            DAY,
            -(DATEDIFF(DAY, '19000101', CAST([Calendar] AS DATE)) % 7),
            CAST([Calendar] AS DATE)
        ) AS DATE
    )                                                                 AS week_commencing,
    YEAR(
        DATEADD(
            DAY,
            3 - (DATEDIFF(DAY, '19000101', CAST([Calendar] AS DATE)) % 7),
            CAST([Calendar] AS DATE)
        )
    ) * 100
    + DATEPART(ISO_WEEK, CAST([Calendar] AS DATE))                    AS year_week
INTO Haleon.Boots_Sales_History_Normalized
FROM Haleon.Boots_Sales_Raw
WHERE CAST([Calendar] AS DATE) >= @load_start_date;
GO

-- Validate
SELECT
    COUNT(*)                            AS total_rows,
    COUNT(DISTINCT article_id)          AS distinct_articles,
    COUNT(DISTINCT store_id)            AS distinct_stores,
    COUNT(DISTINCT year_week)           AS distinct_weeks,
    SUM(CASE WHEN sales_value IS NULL THEN 1 ELSE 0 END) AS null_sales_value_rows,
    SUM(CASE WHEN sales_qty IS NULL THEN 1 ELSE 0 END)   AS null_sales_qty_rows
FROM Haleon.Boots_Sales_History_Normalized;
GO


-- =====================================================================
-- STEP 1: Aggregate daily rows to Article x Store x Week (history)
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[1Haleon_Boots_History_Weekly];

SELECT
    article_id,
    MAX(article_description)                                    AS article_description,
    -- ^ MAX() as an ANY_VALUE() substitute — description is
    --   functionally dependent on article_id, so MAX is safe here.
    --   Swap for ANY_VALUE(article_description) if compat level allows.
    store_id,
    year_week,
    week_commencing,
    SUM(sales_value)                                             AS sales_value,
    SUM(sales_qty)                                               AS sales_qty,
    AVG(CAST(stock_volume AS FLOAT))                             AS stock_volume,
    CASE WHEN SUM(sales_value) > 0 THEN 1 ELSE 0 END             AS skus_selling
INTO Haleon.[1Haleon_Boots_History_Weekly]
FROM Haleon.Boots_Sales_History_Normalized
GROUP BY article_id, store_id, year_week, week_commencing;
GO

-- Validation check
SELECT
    COUNT(*)                       AS aggregated_rows,
    COUNT(DISTINCT article_id)     AS distinct_articles,
    COUNT(DISTINCT store_id)       AS distinct_stores,
    COUNT(DISTINCT year_week)      AS distinct_weeks,
    SUM(sales_qty)                 AS total_qty,
    CAST(ROUND(SUM(sales_value), 2) AS NUMERIC(18,2)) AS total_value
FROM Haleon.[1Haleon_Boots_History_Weekly];
GO


-- =====================================================================
-- STEP 2: Roll up to Store x Week
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[2Haleon_Boots_History_Store_by_Week];

SELECT
    store_id,
    year_week,
    week_commencing,
    SUM(sales_qty)      AS weekly_sales_qty,
    SUM(skus_selling)   AS weekly_skus_selling
INTO Haleon.[2Haleon_Boots_History_Store_by_Week]
FROM Haleon.[1Haleon_Boots_History_Weekly]
GROUP BY store_id, year_week, week_commencing;
GO


-- =====================================================================
-- STEP 3: Average weekly performance by store, over the history window
-- =====================================================================
DECLARE @history_start_date DATE = '2026-06-01';   -- <-- keep in sync with Step 0
DECLARE @history_end_date   DATE = '2026-07-27';   -- <-- ADJUST

DROP TABLE IF EXISTS Haleon.[3Haleon_Boots_Avg_Sales_Store_by_Wk];

SELECT
    store_id,
    AVG(CAST(weekly_sales_qty AS FLOAT))               AS avg_qty_by_week,
    AVG(CAST(weekly_skus_selling AS FLOAT))            AS avg_skus_selling_per_week,
    COUNT(DISTINCT year_week)                          AS weeks_available
INTO Haleon.[3Haleon_Boots_Avg_Sales_Store_by_Wk]
FROM Haleon.[2Haleon_Boots_History_Store_by_Week]
WHERE week_commencing BETWEEN @history_start_date AND @history_end_date
GROUP BY store_id;
GO


-- =====================================================================
-- STEP 4: Assign each store to a peer group (NTILE)
-- =====================================================================
DECLARE @num_groups INT = 10;  -- <-- ADJUST based on Boots' actual store count

DROP TABLE IF EXISTS Haleon.[4Haleon_Boots_Store_Groups];

SELECT
    store_id,
    avg_qty_by_week,
    avg_skus_selling_per_week,
    NTILE(@num_groups) OVER (ORDER BY avg_qty_by_week DESC) AS group_id
INTO Haleon.[4Haleon_Boots_Store_Groups]
FROM Haleon.[3Haleon_Boots_Avg_Sales_Store_by_Wk];
GO

-- Validate
SELECT group_id, COUNT(*) AS num_stores
FROM Haleon.[4Haleon_Boots_Store_Groups]
GROUP BY group_id
ORDER BY group_id;
GO


