--Boots Predict Alert — Interim T-SQL script (v2)
--Base template: the Asda interim script (structure, column naming,
--table numbering pattern all carried over 1:1 wherever Boots' data
--shape allows).
--
--Deviations from the Asda script, and why:
--  1. Product column arrives combined as "<Article_ID> - <Description>"
--     -> split on the FIRST " - " occurrence (Asda had these as two
--     separate source columns already).
--  2. Total_Sales_Amount_per_Store / Total_Sales_Volume_per_Store_Units
--     arrive as VARCHAR with literal string 'NA' mixed in with
--     numerics -> NULLIF + TRY_CAST used instead of a plain CAST.
--     'NA' -> NULL (not 0). Change if you want 0 instead.
--  3. New column: stock_volume, from Store_On_Hand_Volume_Units. Asda
--     had no stock data at all, so this has no Asda equivalent.
--  4. site_name dropped entirely — Boots' source has no store-name
--     column (only Store_Id), unlike Asda's Site_Name.
--  5. Asda's HISTORY table arrived with Week_Commencing / Year_Week_Number
--     already populated (only the CURRENT-WEEK table needed the
--     ALTER TABLE + UPDATE block). Boots' raw file has neither table
--     pre-populated — only Calendar — so that same block is run TWICE
--     here: once for history, once for current week.
--  6. Step 11 classification is stock-aware (3 alert types: Low Sales /
--     Stock No Sales / Ranged Not Stocked), per your confirmation,
--     since stock_volume is real data for Boots. ranged_flag is a
--     placeholder hardcoded to 1 (no planogram source exists yet —
--     same caveat that applied when this logic first appeared).
--
--ASSUMPTIONS TO CONFIRM / ADJUST:
--  - Raw history table: Haleon.Boo_20260711_to_20260808 — this is
--    NEVER altered or written to. Everything downstream runs against
--    a duplicate, Haleon.Landing_Boo_20260711_to_20260808, created in
--    Step 0 below.
--  - Current-week raw table: Haleon.Boots_Sales_CurrentWeek_Raw
--    (placeholder — rename to match whatever your import produces).
--    Same protection applies: a Landing_ duplicate is made before any
--    ALTER/UPDATE touches it.
--  - stock_volume is AVERAGED across the week per store x article
--    (it's a snapshot, not additive) — change to MAX/last-day if
--    you'd rather.
--  - @num_groups = 10, matching Asda's setting — adjust based on
--    Boots' actual store count.

-- =====================================================================
-- STEP 0: Duplicate the raw history table into a Landing_ copy
-- =====================================================================
-- The original Haleon.Boo_20260711_to_20260808 must remain untouched —
-- all ALTER/UPDATE work below happens on this duplicate instead.
DROP TABLE IF EXISTS Haleon.Landing_Boo_20260711_to_20260808;

SELECT *
INTO Haleon.Landing_Boo_20260711_to_20260808
FROM Haleon.Boo_20260711_to_20260808;
GO

-- =====================================================================
-- ADD WEEK_COMMENCING & YEAR_WEEK_NUMBER — HISTORY LANDING TABLE
-- =====================================================================
-- Boots' raw file only has [Calendar] (daily date) — no pre-computed
-- week fields like Asda's history table had, so this step is added
-- here (Asda didn't need it for history, only for the current week).
-- Runs against the Landing_ duplicate, never the original.
ALTER TABLE Haleon.Landing_Boo_20260711_to_20260808
ADD
    Week_Commencing DATE,
    Year_Week_Number INT;
GO

UPDATE Haleon.Landing_Boo_20260711_to_20260808
SET
    Week_Commencing =
        CAST(
            DATEADD(
                DAY,
                -(DATEDIFF(DAY, '19000101', TRY_CAST(Calendar AS DATE)) % 7),
                TRY_CAST(Calendar AS DATE)
            )
            AS DATE
        ),
    Year_Week_Number =
        YEAR(
            DATEADD(
                DAY,
                3 - (DATEDIFF(DAY, '19000101', TRY_CAST(Calendar AS DATE)) % 7),
                TRY_CAST(Calendar AS DATE)
            )
        ) * 100
        +
        DATEPART(ISO_WEEK, TRY_CAST(Calendar AS DATE));
GO


-- =====================================================================
-- STEP 1: Normalize the history landing table
-- =====================================================================
DECLARE @load_start_date DATE = '2026-06-01';   -- <-- ADJUST: e.g. ~2 months back

DROP TABLE IF EXISTS Haleon.Boots_Sales_202606_to_202607_History_Normalized;

SELECT
    [Store_Id]                                                       AS store_id,
    LTRIM(RTRIM(LEFT([Product], CHARINDEX(' - ', [Product]) - 1)))   AS article_id,
    LTRIM(RTRIM(SUBSTRING([Product], CHARINDEX(' - ', [Product]) + 3, 4000)))
                                                                      AS article_description,
    TRY_CAST(NULLIF([Total_Sales_Volume_per_Store_Units], 'NA') AS INT)
                                                                      AS sales_qty,
    TRY_CAST(NULLIF([Total_Sales_Amount_per_Store], 'NA') AS NUMERIC(18,2))
                                                                      AS sales_value,
    TRY_CAST(NULLIF([Store_On_Hand_Volume_Units], 'NA') AS INT)      AS stock_volume,
    CAST([Calendar] AS DATE)                                         AS sale_date,
    CAST([Week_Commencing] AS DATE)                                  AS week_commencing,
    CAST([Year_Week_Number] AS INT)                                  AS year_week
INTO Haleon.Boots_Sales_202606_to_202607_History_Normalized
FROM Haleon.Landing_Boo_20260711_to_20260808
WHERE [Calendar] >= @load_start_date;
GO


-- =====================================================================
-- STEP 2: Aggregate daily rows to Article x Store x Week
-- =====================================================================
-- skus_selling = IF(sales_value / sales_qty > 0, 1, 0), applied to the
-- WEEKLY totals
-- =====================================================================

DROP TABLE IF EXISTS Haleon.[2Haleon_Boots_History_Weekly];

SELECT
    article_id,
    article_description,
    store_id,
    year_week,
    week_commencing,
    SUM(sales_value)                                            AS sales_value,
    SUM(sales_qty)                                              AS sales_qty,
    AVG(CAST(stock_volume AS FLOAT))                            AS stock_volume,
    CASE
        WHEN SUM(sales_value) > 0 THEN 1
    ELSE 0
    END                                                          AS skus_selling
INTO Haleon.[2Haleon_Boots_History_Weekly]
FROM Haleon.Boots_Sales_202606_to_202607_History_Normalized
GROUP BY article_id,
    article_description,
    store_id,
    year_week,
    week_commencing;
GO

-- Validation check:
SELECT
    COUNT(*)                       AS aggregated_rows,
    COUNT(DISTINCT article_id)     AS distinct_articles,
    COUNT(DISTINCT store_id)       AS distinct_stores,
    COUNT(DISTINCT year_week)      AS distinct_weeks,
    SUM(sales_qty)                 AS total_qty,
    CAST(ROUND(SUM(sales_value), 2) AS NUMERIC(18,2)) AS total_value
FROM Haleon.[2Haleon_Boots_History_Weekly];
GO


-- =====================================================================
-- STEP 3: Roll up to Store x Week
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[3Haleon_Boots_History_Store_by_Week];

SELECT
    store_id,
    year_week,
    week_commencing,
    SUM(sales_qty)                 AS weekly_sales_qty,
    SUM(skus_selling)              AS weekly_skus_selling
INTO Haleon.[3Haleon_Boots_History_Store_by_Week]
FROM Haleon.[2Haleon_Boots_History_Weekly]
GROUP BY store_id,
    year_week,
    week_commencing;
GO

-- Validation check:
SELECT
