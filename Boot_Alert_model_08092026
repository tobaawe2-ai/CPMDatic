-- =====================================================================
-- STEP 4: Average weekly performance by store, over YOUR chosen analysis window
-- =====================================================================

DECLARE @history_start_date DATE = '2026-06-01';
DECLARE @history_end_date   DATE = '2026-07-27';
DECLARE @num_groups INT = 10;  --Adjust as required

-- NOTE: unlike Asda's script (where this was commented out because the
-- table was already built), this needs to run at least once for Boots.
-- Comment it back out on subsequent runs if you don't want to rebuild it.

DROP TABLE IF EXISTS Haleon.[4Haleon_Boots_History_Avg_Sales_Store_by_Wk];

SELECT
    store_id,
    AVG(CAST(weekly_sales_qty AS FLOAT))               AS avg_qty_by_week,
    AVG(CAST(weekly_skus_selling AS FLOAT))            AS avg_skus_selling_per_week,
    COUNT(DISTINCT year_week)                          AS weeks_available
INTO Haleon.[4Haleon_Boots_History_Avg_Sales_Store_by_Wk]
FROM Haleon.[3Haleon_Boots_History_Store_by_Week]
WHERE week_commencing BETWEEN @history_start_date AND @history_end_date
GROUP BY store_id;
GO

-- Store groups (NTILE)
DROP TABLE IF EXISTS Haleon.[5Haleon_Boots_Store_Groups];

SELECT
    store_id,
    avg_qty_by_week,
    avg_skus_selling_per_week,
    NTILE(@num_groups) OVER (ORDER BY avg_qty_by_week DESC) AS group_id
INTO Haleon.[5Haleon_Boots_Store_Groups]
FROM Haleon.[4Haleon_Boots_History_Avg_Sales_Store_by_Wk];
GO


-- Validation check:
SELECT
    COUNT(*)                                                AS total_stores,
    MIN(avg_qty_by_week)                                    AS minimum_avg_weekly_qty,
    MAX(avg_qty_by_week)                                    AS maximum_avg_weekly_qty,
    AVG(avg_qty_by_week)                                    AS overall_avg_weekly_qty,
    SUM(CASE WHEN weeks_available = DATEDIFF(WEEK, @history_start_date, @history_end_date) + 1
             THEN 1 ELSE 0 END)                             AS stores_with_full_history,
    SUM(CASE WHEN weeks_available < DATEDIFF(WEEK, @history_start_date, @history_end_date) + 1
             THEN 1 ELSE 0 END)                              AS stores_with_incomplete_history
FROM Haleon.[4Haleon_Boots_History_Avg_Sales_Store_by_Wk];
GO


