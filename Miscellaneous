    MAX(CASE WHEN rn = 3  THEN item_ref_no END)  AS ItemRefNo3,
    MAX(CASE WHEN rn = 4  THEN item_ref_no END)  AS ItemRefNo4,
    MAX(CASE WHEN rn = 5  THEN item_ref_no END)  AS ItemRefNo5
    
INTO Haleon.Asda_20260801_to_20260812_Alert_Load_Step3_Pivot
FROM Haleon.Asda_20260801_to_20260812_Alert_Load_Step2_Top5
GROUP BY store_id;
