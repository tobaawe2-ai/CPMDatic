-- =====================================================================
-- STEP 10: Enrich current week's sales with the benchmark
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[10Haleon_Asda_Sales_Enriched];

SELECT
    s.article_id,
    s.article_description,
    s.store_id,
    s.site_name,
    s.year_week,
    s.week_commencing,
    s.sales_value,
    s.sales_qty,
    s.group_id,
    b.predicted_units,
    b.avg_price
INTO Haleon.[10Haleon_Asda_Sales_Enriched]
FROM Haleon.[8Haleon_Asda_CurrentWeek_with_Group] AS s
LEFT JOIN Haleon.[9Haleon_Asda_Product_Group_Benchmark] AS b
    ON s.article_id = b.article_id AND s.group_id = b.group_id;
GO

-- =====================================================================
-- STEP 11: Flag price alerts (Low Sales only — no stock data)
-- =====================================================================
DECLARE @hurdle_rate FLOAT = 10.0;

DROP TABLE IF EXISTS Haleon.[11Haleon_Asda_Alerts_Calc];

WITH flags AS (
    SELECT
        *,
        CAST(sales_qty AS FLOAT) / NULLIF(predicted_units, 0)   AS actual_vs_predicted
    FROM Haleon.[10Haleon_Asda_Sales_Enriched]
),
sized AS (
    SELECT
        *,
        CASE WHEN ISNULL(actual_vs_predicted, 0) < 0.5 THEN 1 ELSE 0 END AS low_sales,
        GREATEST(ISNULL(predicted_units, 0) - sales_qty, 0)               AS lost_qty
    FROM flags
),
priced AS (
    SELECT
        *,
        ROUND(lost_qty * ISNULL(avg_price, 0), 2)      AS size_of_prize
    FROM sized
),
classified AS (
    SELECT
        *,
        CASE WHEN low_sales = 1 THEN 'Low Sales' ELSE 'No Alert' END AS alert_type,
        CASE WHEN size_of_prize >= @hurdle_rate THEN 1 ELSE 0 END    AS hits_hurdle
    FROM priced
)
SELECT
    *,
    CASE WHEN alert_type = 'Low Sales' AND hits_hurdle = 1 THEN 'Y' ELSE 'N' END AS alert_to_action
INTO Haleon.[11Haleon_Asda_Alerts_Calc]
FROM classified;
GO


SELECT * FROM Haleon.[11Haleon_Asda_Alerts_Calc]

-- =====================================================================
-- STEP 12: Alerts Summary
-- =====================================================================
-- 12a. By alert type
DROP TABLE IF EXISTS Haleon.[12Haleon_Asda_Alerts_Summary_by_Type];

WITH actioned AS (
    SELECT * FROM Haleon.[11Haleon_Asda_Alerts_Calc] WHERE alert_to_action = 'Y'
),
totals AS (
    SELECT COUNT(*) AS total_alerts FROM actioned
)
SELECT
    a.alert_type,
    COUNT(*)                                                       AS num_alerts,
    ROUND(SUM(a.size_of_prize), 2)                                 AS size_of_prize,
    ROUND(AVG(a.size_of_prize), 2)                                 AS avg_size_of_prize,
    ROUND(CAST(COUNT(*) AS FLOAT) / NULLIF(t.total_alerts, 0), 4)  AS pct_alerts
INTO Haleon.[12Haleon_Asda_Alerts_Summary_by_Type]
FROM actioned AS a
CROSS JOIN totals t
GROUP BY a.alert_type, t.total_alerts

UNION ALL

SELECT
    'Total Alerts'                             AS alert_type,
    COUNT(*)                                   AS num_alerts,
    ROUND(SUM(size_of_prize), 2)               AS size_of_prize,
    ROUND(AVG(size_of_prize), 2)               AS avg_size_of_prize,
    CAST(NULL AS FLOAT)                        AS pct_alerts
FROM Haleon.[11Haleon_Asda_Alerts_Calc]
WHERE alert_to_action = 'Y';
GO

-- 12b. By product
DROP TABLE IF EXISTS Haleon.[12Haleon_Asda_Alerts_Summary_by_Product];

WITH actioned AS (
    SELECT * FROM Haleon.[11Haleon_Asda_Alerts_Calc] WHERE alert_to_action = 'Y'
),
totals AS (
    SELECT COUNT(*) AS total_alerts FROM actioned
)
SELECT
    a.article_id,
    a.article_description,
    COUNT(*)                                                                 AS num_alerts,
    ROUND(SUM(a.size_of_prize), 2)                                          AS size_of_prize,
    ROUND(AVG(a.size_of_prize), 2)                                          AS avg_size_of_prize,
    ROUND(CAST(COUNT(*) AS FLOAT) / NULLIF(t.total_alerts, 0), 4) AS pct_alerts
INTO Haleon.[12Haleon_Asda_Alerts_Summary_by_Product]
FROM actioned a
CROSS JOIN totals t
GROUP BY a.article_id, a.article_description, t.total_alerts;
GO



