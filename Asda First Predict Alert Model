-- Store groups (NTILE)
DROP TABLE IF EXISTS Haleon.[5Haleon_Asda_Store_Groups];

SELECT
    store_id,
    site_name,
    avg_qty_by_week,
    avg_skus_selling_per_week,
    NTILE(@num_groups) OVER (ORDER BY avg_qty_by_week DESC) AS group_id
INTO Haleon.[5Haleon_Asda_Store_Groups]
FROM Haleon.[4Haleon_Asda_History_Avg_Sales_Store_by_Wk];
GO


