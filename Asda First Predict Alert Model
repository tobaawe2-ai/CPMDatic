-- =====================================================================
-- STEP 1: Normalize the 14-month history landing table
-- =====================================================================
DECLARE @load_start_date DATE = '2026-06-01';   -- <-- ADJUST: e.g. ~2 months back
 
DROP TABLE IF EXISTS Haleon.Asda_Sales_202606_to_202607_History_Normalized;

SELECT
    [Site_Name]                              AS site_name,
    [Site_Number]                            AS store_id,
    [Article_ID]                             AS article_id,
    [Article_Description]                    AS article_description,
    CAST([Sales_Qty] AS INT)                 AS sales_qty,
    CAST([Sales_Amount] AS NUMERIC(18,2))    AS sales_value,
    CAST([Asda_Daily] AS DATE)               AS sale_date,
    CAST([Week_Commencing] AS DATE)          AS week_commencing,
    CAST([Year_Week_Number] AS INT)          AS year_week
INTO  Haleon.Asda_Sales_202606_to_202607_History_Normalized
FROM Haleon.Asda_Sales_202505_to_202607
WHERE [Asda_Daily] >= @load_start_date;  
GO

-- =====================================================================
-- STEP 2: Aggregate daily rows to Article x Store x Week
-- =====================================================================
-- skus_selling = IF(sales_value / sales_qty > 0, 1, 0), applied to the
-- WEEKLY totals 
-- =====================================================================

DROP TABLE IF EXISTS Haleon.[2Haleon_Asda_History_Weekly];

SELECT
    article_id,
    article_description,
    store_id,
    site_name,
    year_week,
    week_commencing,
    SUM(sales_value)                                            AS sales_value,
    SUM(sales_qty)                                              AS sales_qty,
    CASE
        WHEN SUM(sales_value) > 0 THEN 1
    ELSE 0
    END                                                          AS skus_selling
INTO Haleon.[2Haleon_Asda_History_Weekly]
FROM Haleon.Asda_Sales_202606_to_202607_History_Normalized
GROUP BY article_id,
    article_description,
    store_id,
    site_name,
    year_week,
    week_commencing;
GO

-- Validation check: 
SELECT
    COUNT(*)                       AS aggregated_rows,
    COUNT(DISTINCT article_id)     AS distinct_articles,
    COUNT(DISTINCT store_id)       AS distinct_stores,
    COUNT(DISTINCT year_week)      AS distinct_weeks,
    SUM(sales_qty)                 AS total_qty,
    CAST(ROUND(SUM(sales_value), 2) AS NUMERIC(18,2)) AS total_value
FROM Haleon.[2Haleon_Asda_History_Weekly];
GO


-- =====================================================================
-- STEP 3: Roll up to Store x Week
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[3Haleon_Asda_History_Store_by_Week];

SELECT
    store_id,
    site_name,
    year_week,
    week_commencing,
    SUM(sales_qty)                 AS weekly_sales_qty,
    SUM(skus_selling)              AS weekly_skus_selling
INTO Haleon.[3Haleon_Asda_History_Store_by_Week]
FROM Haleon.[2Haleon_Asda_History_Weekly]
GROUP BY store_id,
    site_name,
    year_week,
    week_commencing;
GO

