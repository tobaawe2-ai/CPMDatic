-- =====================================================================
-- STEP 8: Join to store groups + safety check against the history window
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[8Haleon_Asda_CurrentWeek_with_Group];

SELECT
    s.article_id,
    s.article_description,
    s.store_id,
    s.site_name,
    s.year_week,
    s.week_commencing,
    s.sales_value,
    s.sales_qty,
    sg.group_id
INTO Haleon.[8Haleon_Asda_CurrentWeek_with_Group]
FROM Haleon.[7Haleon_Asda_CurrentWeek_Weekly] AS s
LEFT JOIN Haleon.[5Haleon_Asda_Store_Groups] AS sg
    ON s.store_id = sg.store_id;
GO

-- Safety check: the week being scored should be AFTER the historical
-- window used for grouping, not inside it.
DECLARE @scored_week_commencing DATE =
    (SELECT MIN(week_commencing) FROM Haleon.[8Haleon_Asda_CurrentWeek_with_Group]);
DECLARE @history_end_date_check DATE = '2026-07-27';  -- keep in sync with Step 4 above

SELECT
    @scored_week_commencing   AS scored_week_commencing,
    @history_end_date_check   AS history_end_date,
    CASE
        WHEN @scored_week_commencing <= @history_end_date_check
        THEN 'WARNING: scored week overlaps the history window — check your dates'
        ELSE 'OK: scored week is after the history window'
    END AS overlap_check;
GO

