-- #######################################################################
-- ##  ADD WEEK_COMMENCING & YEAR_WEEK_NUMBER FIELD
-- #######################################################################


ALTER TABLE Haleon.Asda_Sales_2026_07_WK32_to_33
ADD
    Week_Commencing DATE,
    Year_Week_Number INT;
GO

UPDATE  Haleon.Asda_Sales_2026_07_WK32_to_33
SET
    Week_Commencing =
        CAST(
            DATEADD(
                DAY,
                -(DATEDIFF(DAY, '19000101', TRY_CAST(Asda_Daily AS DATE)) % 7),
                TRY_CAST(Asda_Daily AS DATE)
            )
            AS DATE
        ),

    Year_Week_Number =
        YEAR(
            DATEADD(
                DAY,
                3 - (DATEDIFF(DAY, '19000101', TRY_CAST(Asda_Daily AS DATE)) % 7),
                TRY_CAST(Asda_Daily AS DATE)
            )
        ) * 100
        +
        DATEPART(
            ISO_WEEK,
            TRY_CAST(Asda_Daily AS DATE)
        );
GO

