-- =====================================================================
-- STEP 9: Product benchmark — peer comparison within the current week
-- =====================================================================
DROP TABLE IF EXISTS Haleon.[9Haleon_Asda_Product_Group_Benchmark];

SELECT
    article_id,
   article_description,
    group_id,
    AVG(CAST(sales_qty AS FLOAT))                                                    AS predicted_units,
    AVG(CAST(sales_value AS FLOAT)) / NULLIF(AVG(CAST(sales_qty AS FLOAT)), 0)       AS avg_price
INTO Haleon.[9Haleon_Asda_Product_Group_Benchmark]
FROM Haleon.[8Haleon_Asda_CurrentWeek_with_Group]
WHERE group_id IS NOT NULL
GROUP BY article_id, group_id, article_description;
GO

